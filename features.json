{
  "version": 1,
  "updatedAt": "2026-11-25",
  "base": {
    "label": "Vuesp base",
    "always": true,
    "firmware": [
      "src/main.cpp",
      "src/config",
      "src/const",
      "src/device",
      "src/diag",
      "src/discovery",
      "src/eeprom",
      "src/files",
      "src/gpio",
      "src/init",
      "src/libs",
      "src/setup",
      "src/tasks",
      "src/utils",
      "src/webserver"
    ],
    "web": [
      "vue/src/App.vue",
      "vue/src/main.ts",
      "vue/src/assets",
      "vue/src/components",
      "vue/src/composables",
      "vue/src/generated",
      "vue/src/icons",
      "vue/src/pages/index.vue",
      "vue/src/pages/dashboard",
      "vue/src/pages/device",
      "vue/src/pages/[...path].vue",
      "vue/src/router",
      "vue/src/stores",
      "vue/src/types",
      "vue/src/utils",
      "vue/json/dashboard.json",
      "vue/json/locales",
      "vue/json/suggestions.json"
    ]
  },
  "features": {
    "script": {
      "label": "ScriptRunner",
      "summary": "Local scripting: editor, slots, logs and script execution.",
      "firmware": [
        "src/runner"
      ],
      "web": [
        "vue/src/pages/script",
        "vue/src/composables/script",
        "vue/src/assets/js/script"
      ],
      "menu": [
        "menu.script"
      ],
      "locales": [
        "script",
        "editor",
        "logs",
        "slots",
        "examples",
        "noScripts",
        "noLogs",
        "selectScript"
      ],
      "protocol": [],
      "wiring": [
        "src/main.cpp: include ./runner/runner.h, setupRunner(), loopRunner(now)",
        "src/webserver/webserver.cpp: scriptRunner.emitEvent(), registerScript(), runScript()"
      ],
      "remove": [
        "delete src/runner, vue/src/pages/script, vue/src/composables/script, vue/src/assets/js/script",
        "remove menu.script from vue/json/menu.json",
        "remove the runner include and setupRunner()/loopRunner() calls from src/main.cpp",
        "remove scriptRunner calls from src/webserver/webserver.cpp",
        "keep protocol keys: the script feature uses KEY.MESSAGE from the base"
      ]
    },
    "serial": {
      "label": "SERIAL example",
      "summary": "Example console page built on SerialConsole with a demo transport.",
      "firmware": [],
      "web": [
        "vue/src/pages/serial"
      ],
      "menu": [
        "menu.serial"
      ],
      "locales": [
        "serial.demoPort",
        "serial.demoHint"
      ],
      "protocol": [],
      "wiring": [
        "No firmware wiring: the page uses the demo transport."
      ],
      "remove": [
        "delete vue/src/pages/serial",
        "remove menu.serial from vue/json/menu.json",
        "remove serial.* from vue/json/locales/ru.json and en.json"
      ]
    },
    "modbus": {
      "label": "Modbus RTU example",
      "summary": "Modbus RTU master/slave example. Off by default; the user enables it and sets TX/RX/DE pins in the UI.",
      "firmware": [
        "src/modbus"
      ],
      "web": [
        "vue/src/components/service/ServiceModbus.vue",
        "vue/src/components/service/ModbusMapDetails.vue",
        "vue/src/components/service/modbusMapTypes.ts",
        "vue/src/utils/modbusFrame.ts"
      ],
      "menu": [
        "menu.modbus"
      ],
      "locales": [
        "menu.modbus",
        "modbus"
      ],
      "protocol": [
        "MODBUS",
        "MODBUSPROFILE",
        "MODBUSRAW"
      ],
      "wired": true,
      "wiring": [
        "src/main.cpp: setupFirstModbus(), setupModbus(), loopModbus(now)",
        "src/webserver/webserver.cpp: MODBUS, MODBUSPROFILE and MODBUSRAW handlers"
      ],
      "remove": [
        "delete src/modbus",
        "delete vue/src/components/service/ServiceModbus.vue, ModbusMapDetails.vue, modbusMapTypes.ts",
        "delete vue/src/utils/modbusFrame.ts",
        "remove menu.modbus from vue/json/menu.json",
        "remove modbus.* and menu.modbus from vue/json/locales/ru.json and en.json",
        "keep protocol keys: MODBUS, MODBUSPROFILE, MODBUSRAW"
      ],
      "notes": [
        "Disabled by default: role = off, UART is not started until the user connects.",
        "Pins are runtime settings in the UI (TX/RX/DE); DE -1 means auto-direction.",
        "ESP32/C3 only: the module compiles on ESP8266, but the UART is not started there.",
        "Template register map is generic: firmware/uptime/address/baud/role/errors/requests/RTC + slave bank 100–131."
      ]
    }
  }
}
